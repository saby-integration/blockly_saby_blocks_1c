	ITEM.Вставить("PARENT", PARENT);
	ITEM.Вставить("IS_FOLDER", IS_FOLDER);
	ITEM.Вставить("TITLE", TITLE);
	ITEM.Вставить("VALUE", VALUE);
	
	Возврат ITEM;	
	
КонецФункции	

//DynamicDirective

Функция КолонкаДокументов(NAME, TITLE, TYPE, PROPERTY, VISIBLE, WIDTH, HORIZONTALSTRETCH = Истина, MORE_LOAD = Истина) 
	КолонкаСписка = Новый Соответствие;
	КолонкаСписка.Вставить("NAME", NAME);
	КолонкаСписка.Вставить("TITLE", TITLE);
	КолонкаСписка.Вставить("TYPE", TYPE);
	КолонкаСписка.Вставить("PROPERTY", PROPERTY);
	КолонкаСписка.Вставить("VISIBLE", VISIBLE);
	КолонкаСписка.Вставить("WIDTH", WIDTH);
	КолонкаСписка.Вставить("ALIGN", "2");
	КолонкаСписка.Вставить("HORIZONTALSTRETCH", HORIZONTALSTRETCH);
	КолонкаСписка.Вставить("MORE_LOAD", MORE_LOAD);
	КолонкаСписка.Вставить("TEMPLATE", "column_default");
	Возврат КолонкаСписка;
КонецФункции	

