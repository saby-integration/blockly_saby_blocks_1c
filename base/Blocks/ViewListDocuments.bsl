		КомандыДокументов.Добавить(КомандаВыгрузитьВложенияИзSaby);
	ИначеЕсли ACTIONS_SET = "1/0" Тогда
		КомандаЗагрузитьВSaby = КомандаДокументов("ЗагрузитьВSaby", "Загрузить в " + ЛокализацияНазваниеПродукта(),,,,,,,, "OPEN_FORM_MODULE", "Template", "OperationImport");
		КомандыДокументов.Добавить(КомандаЗагрузитьВSaby);
		КомандаВыгрузитьИзSaby = КомандаДокументов("ВыгрузитьИзSaby", "Выгрузить из " + ЛокализацияНазваниеПродукта(),,,,,,,, "BLOCKLY_RUN_FOR_SELECTED_ITEMS_IN_MODULE",
								algorithm_str, "Blockly_Документы_update", endpoint_str, endpoint_main);
		КомандыДокументов.Добавить(КомандаВыгрузитьИзSaby);
	ИначеЕсли ACTIONS_SET = "0/25/1" Тогда
		КомандаВыгрузитьИзSaby = КомандаДокументов("ВыгрузитьИзSaby", "Выгрузить из " + ЛокализацияНазваниеПродукта(),,,,,,,, "BLOCKLY_RUN_FOR_SELECTED_ITEMS_IN_MODULE",
								algorithm_str, "Blockly_Документы_update", endpoint_str, endpoint_main);
		КомандыДокументов.Добавить(КомандаВыгрузитьИзSaby);
		КомандаВыгрузитьВложенияИзSaby = КомандаДокументов("ВыгрузитьВложенияИзSaby", "Выгрузить вложения из " + ЛокализацияНазваниеПродукта(),,,,,,,, "BLOCKLY_RUN_FOR_SELECTED_ITEMS_IN_MODULE",
															algorithm_str, "Blockly_ExportAttachment_operation", endpoint_str, endpoint_main);
		КомандыДокументов.Добавить(КомандаВыгрузитьВложенияИзSaby);
		КомандаЗагрузитьВSaby = КомандаДокументов("ЗагрузитьВSaby", "Загрузить в " + ЛокализацияНазваниеПродукта(),,,,,,,, "OPEN_FORM_MODULE", "Template", "OperationImport");
		КомандыДокументов.Добавить(КомандаЗагрузитьВSaby);
	ИначеЕсли ACTIONS_SET = "20/0/25/1" Тогда
		КомандаВыполнитьПереходЭДО = КомандаДокументов("ВыполнитьПереходЭДО", "Выполнить в " + ЛокализацияНазваниеПродукта(),,,,,,,, "OPEN_FORM_MODULE", "Template", "OperationEdoAction");
		КомандыДокументов.Добавить(КомандаВыполнитьПереходЭДО);
		КомандаВыгрузитьИзSaby = КомандаДокументов("ВыгрузитьИзSaby", "Выгрузить из " + ЛокализацияНазваниеПродукта(),,,,,,,, "BLOCKLY_RUN_FOR_SELECTED_ITEMS_IN_MODULE",
								algorithm_str, "Blockly_Документы_update", endpoint_str, endpoint_main);
		КомандыДокументов.Добавить(КомандаВыгрузитьИзSaby);
		КомандаВыгрузитьВложенияИзSaby = КомандаДокументов("ВыгрузитьВложенияИзSaby", "Выгрузить вложения из " + ЛокализацияНазваниеПродукта(),,,,,,,, "BLOCKLY_RUN_FOR_SELECTED_ITEMS_IN_MODULE",
															algorithm_str, "Blockly_ExportAttachment_operation", endpoint_str, endpoint_main);
		КомандыДокументов.Добавить(КомандаВыгрузитьВложенияИзSaby);
		КомандаЗагрузитьВSaby = КомандаДокументов("ЗагрузитьВSaby", "Загрузить в " + ЛокализацияНазваниеПродукта(),,,,,,,, "OPEN_FORM_MODULE", "Template", "OperationImport");
		КомандыДокументов.Добавить(КомандаЗагрузитьВSaby);
	КонецЕсли;
	
	ДопКоманды = get_prop(ПараметрыОтображения, "ACTIONS", Новый Массив);
	Если ДопКоманды.Количество() > 0 Тогда
		Для каждого ДопКоманда Из ДопКоманды Цикл
			КомандыДокументов.Добавить(ДопКоманда);
		КонецЦикла;	
	КонецЕсли;
	
	КомандаОткрытьВSaby = КомандаДокументов("OPEN_FORM_SABY", "Открыть в " + ЛокализацияНазваниеПродукта(),,,,,,,, "OPEN_FORM_SABY");  
	КомандыДокументов.Добавить(КомандаОткрытьВSaby);
	
	КомандаОткрытьВИС = КомандаДокументов("OPEN_FORM_IS", "Открыть в 1С",,,,,,,, "OPEN_FORM_IS");  
	КомандыДокументов.Добавить(КомандаОткрытьВИС);
	
	КомандаОбновить = КомандаДокументов("REFRESH_ITEMS", "Обновить список",,,,,,,, "REFRESH_ITEMS");  
	КомандыДокументов.Добавить(КомандаОбновить);
	
	КомандаОбновитьСтатусы = КомандаДокументов("ОбновитьСтатусы", "Обновить статусы",,,,,,,, "BLOCKLY_RUN_FOR_SELECTED_ITEMS_IN_MODULE",
															algorithm_str, "Blockly_ОбновитьСтатусы_send", endpoint_str, endpoint_main);
    КомандыДокументов.Добавить(КомандаОбновитьСтатусы);
	
	КомандаПолеПоиска = Новый Соответствие;
	КомандаПолеПоиска.Вставить("TEMPLATE", "search");
	КомандыДокументов.Добавить(КомандаПолеПоиска);
	
    ПараметрыОтображения.Вставить("ACTIONS", КомандыДокументов);
КонецПроцедуры

