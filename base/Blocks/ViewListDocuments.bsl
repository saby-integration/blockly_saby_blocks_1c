Процедура ЗаполнитьКомандыДокументов(ПараметрыОтображения)
	КомандыДокументов = Новый Массив;
	
	endpoint_main = "main";
	algorithm_str = "Algorithm";
	endpoint_str = "Endpoint";
	
	ACTIONS_SET = get_prop(ПараметрыОтображения, "ACTIONS_SET");
