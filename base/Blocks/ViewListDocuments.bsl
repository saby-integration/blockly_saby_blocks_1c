	    КолонкаФизическоеЛицо = КолонкаДокументов("ЧастноеЛицо", "Физическое лицо", ТипСтрока, РеквизитФизическоеЛицо, 
													Истина, ШиринаПоУмолчанию);
		МассивКолонок.Добавить(КолонкаФизическоеЛицо);
	ИначеЕсли COLUMNS_SET = "CONTRACTOR" Тогда
		РеквизитКонтрагент = workspace_find_mutation_by_name(node, "FIELD_CONTRACTOR");
	    КолонкаКонтрагент = КолонкаДокументов("Контрагент", "Контрагент", ТипСтрока, РеквизитКонтрагент, Истина, ШиринаПоУмолчанию);
		МассивКолонок.Добавить(КолонкаКонтрагент);
		РеквизитСумма = workspace_find_mutation_by_name(node, "FIELD_SUM");
	    КолонкаСумма = КолонкаДокументов("Сумма", "Сумма", ТипСтрока, РеквизитСумма, Истина, 100);
		МассивКолонок.Добавить(КолонкаСумма);
	ИначеЕсли COLUMNS_SET = "WAREHOUSE" Тогда
		РеквизитКонтрагент = workspace_find_mutation_by_name(node, "FIELD_CONTRACTOR");
	    КолонкаКонтрагент = КолонкаДокументов("Контрагент", "Контрагент", ТипСтрока, РеквизитКонтрагент, Истина, ШиринаПоУмолчанию);
		МассивКолонок.Добавить(КолонкаКонтрагент);
		РеквизитСклад = workspace_find_mutation_by_name(node, "FIELD_WAREHOUSE");
	    КолонкаСклад = КолонкаДокументов("Склад", "Склад", ТипСтрока, РеквизитСклад, Истина, ШиринаПоУмолчанию);
