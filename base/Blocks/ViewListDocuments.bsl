Процедура ЗаполнитьФильтрыДокументов(ПараметрыОтображения, node) 
	МассивФильтров = Новый Массив;	
	
	ФильтрПериод = ФильтрДокументовПериод("Дата", "Период", 30); 
	МассивФильтров.Добавить(ФильтрПериод);
	
	ТипОрганизация = workspace_find_mutation_by_name(node, "TYPE_ORGANIZATION");
	ФильтрОрганизация = ФильтрДокументовПолеСвязи("НашаОрганизация", "Организация", "Blockly_" + ТипОрганизация + "_list", 
													Ложь, , "Наименование", "ИдИС"); 
	МассивФильтров.Добавить(ФильтрОрганизация);
	
	ТипОтветственный = workspace_find_mutation_by_name(node, "TYPE_RESPONSIBLE");
	ФильтрОтветственный = ФильтрДокументовПолеСвязи("Ответственный", "Ответственный", "Blockly_" + ТипОтветственный + "_list", Ложь, , "Наименование", "ИдИС"); 
	МассивФильтров.Добавить(ФильтрОтветственный);
	
	ITEMS_1С = Новый Массив();
	ITEM0 = ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Проведен", "0");
	ITEMS_1С.Добавить(ITEM0);
	ITEM1 = ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Не проведен", "1");
	ITEMS_1С.Добавить(ITEM1);
	ITEM2 = ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Помечен на удаление", "2");
	ITEMS_1С.Добавить(ITEM2);
	ФильтрСтатусИС = ФильтрДокументовПеречисление(ITEMS_1С, "СтатусИС", "Статус 1С", "");
	МассивФильтров.Добавить(ФильтрСтатусИС);
	
	ITEMS_Saby = Новый Массив();
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Документ редактируется", "0"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Есть документ", "1"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Отправлено приглашение", "2"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Отправлен", "3"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Доставлен", "4"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Ошибка", "6"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Выполнение завершено успешно", "7"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Выполнение завершено с проблемами", "9"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "В обработке", "10"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Отозван мной", "19"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Удален контрагентом", "20"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Аннулирован по соглашению", "22"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Ожидает подписания", "23"));
	ITEMS_Saby.Добавить(ЗаполнитьСоответствиеЗначенияПеречисления("", Ложь, "Ожидает аннулирования", "27"));
	
	ФильтрСтатусSaby = ФильтрДокументовПеречисление(ITEMS_Saby, "СтатусСБИС", "Статус Saby", "");
	МассивФильтров.Добавить(ФильтрСтатусSaby);
	
	FILTER_SET = get_prop(ПараметрыОтображения, "FILTER_SET");
	Если FILTER_SET = "EMPLOYEE" Тогда
		ТипСотрудник = workspace_find_mutation_by_name(node, "TYPE_EMPLOYEE");
		ФильтрСотрудник = ФильтрДокументовПолеСвязи("Сотрудник", "Сотрудник", "Blockly_" + ТипСотрудник + "_list", Истина, , "Наименование", "ИдИС"); 
		МассивФильтров.Добавить(ФильтрСотрудник);
	ИначеЕсли FILTER_SET = "PRIVATE_PERSON" Тогда
		ТипФизическоеЛицо = workspace_find_mutation_by_name(node, "TYPE_PRIVATE_PERSON");
		ФильтрФизическоеЛицо = ФильтрДокументовПолеСвязи("ЧастноеЛицо", "Физическое лицо", "Blockly_" + ТипФизическоеЛицо + "_list", 
															Истина, , "Наименование", "ИдИС"); 
		МассивФильтров.Добавить(ФильтрФизическоеЛицо);
	ИначеЕсли FILTER_SET = "CONTRACTOR" Тогда
		ТипКонтрагент = workspace_find_mutation_by_name(node, "TYPE_CONTRACTOR");
		ФильтрКонтрагент = ФильтрДокументовПолеСвязи("Контрагент", "Контрагент", "Blockly_" + ТипКонтрагент + "_list", Истина, , "Наименование", "ИдИС"); 
		МассивФильтров.Добавить(ФильтрКонтрагент);
	ИначеЕсли FILTER_SET = "WAREHOUSE" Тогда
		ТипКонтрагент = workspace_find_mutation_by_name(node, "TYPE_CONTRACTOR");
		ФильтрКонтрагент = ФильтрДокументовПолеСвязи("Контрагент", "Контрагент", "Blockly_" + ТипКонтрагент + "_list", Истина, , "Наименование", "ИдИС"); 
		МассивФильтров.Добавить(ФильтрКонтрагент);
		ТипСклад = workspace_find_mutation_by_name(node, "TYPE_WAREHOUSE");
	    ФильтрСклад = ФильтрДокументовПолеСвязи("Склад", "Склад", "Blockly_" + ТипСклад + "_list", Истина, , "Наименование", "ИдИС");
		МассивФильтров.Добавить(ФильтрСклад);
	КонецЕсли;
	
	ДопФильтры = get_prop(ПараметрыОтображения, "FILTER", Новый Массив);
	Если ДопФильтры.Количество() > 0 Тогда
		Для каждого ДопФильтр Из ДопФильтры Цикл
			МассивФильтров.Добавить(ДопФильтр);
		КонецЦикла;	
	КонецЕсли;
	
	ПараметрыОтображения.Вставить("FILTER", МассивФильтров);
КонецПроцедуры

