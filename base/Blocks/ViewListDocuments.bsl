Функция ФильтрДокументовПериод(NAME = "", TITLE = "", DEFAULT_VALUE = Неопределено, MIN_RANGE = "") 
	Фильтр = Новый Соответствие;
	Фильтр.Вставить("NAME", NAME);
	Фильтр.Вставить("TITLE", TITLE);
	Фильтр.Вставить("DEFAULT_VALUE", DEFAULT_VALUE);
	Фильтр.Вставить("TEMPLATE", "filter_period");
		
	Возврат Фильтр;
КонецФункции

Функция ФильтрДокументовПолеСвязи(NAME = "", TITLE = "", ALGORITHM = "", MULTI_SELECT = Ложь, DEFAULT_VALUE = Неопределено, DISPLAY_PROPERTY = Неопределено, KEY_PROPERTY = Неопределено) 
