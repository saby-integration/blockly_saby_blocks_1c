//DynamicDirective

Функция КомандаДокументов(NAME = "", TITLE = "", ICON = "", DESCRIPTION = "", DEFAULT_BUTTON = Ложь, SHOW_IN_MAIN_TOOLBAR = Истина, 
	SHOW_IN_DEFAULT_TOOLBAR = Ложь, SHOW_IN_OPERATION_PANEL = Ложь, SHOW_IN_ITEM_ACTION = Истина, ACTION = "", 
	PARAM0_KEY = "", PARAM0_VALUE = "", PARAM1_KEY = "", PARAM1_VALUE = "");
	Команда = Новый Соответствие;
	Команда.Вставить("NAME", NAME);
	Команда.Вставить("TITLE", TITLE);
	Команда.Вставить("ICON", ICON);
	Команда.Вставить("DESCRIPTION", DESCRIPTION);
	Команда.Вставить("DEFAULT_BUTTON", DEFAULT_BUTTON);
	Команда.Вставить("SHOW_IN_MAIN_TOOLBAR", SHOW_IN_MAIN_TOOLBAR);
	Команда.Вставить("SHOW_IN_DEFAULT_TOOLBAR", SHOW_IN_DEFAULT_TOOLBAR);
	Команда.Вставить("SHOW_IN_OPERATION_PANEL", SHOW_IN_OPERATION_PANEL);
	Команда.Вставить("SHOW_IN_ITEM_ACTION", SHOW_IN_ITEM_ACTION);
	Команда.Вставить("ACTION", ACTION);
	ПараметрыКоманды = Новый Структура;
	Если Не PARAM0_KEY = "" Тогда
		ПараметрыКоманды.Вставить(PARAM0_KEY, PARAM0_VALUE);
	КонецЕсли;
	Если Не PARAM1_KEY = "" Тогда
		ПараметрыКоманды.Вставить(PARAM1_KEY, PARAM1_VALUE);
	КонецЕсли;
	Команда.Вставить("ARGS", ПараметрыКоманды);
	Команда.Вставить("TEMPLATE", "command");
	
	Возврат Команда; 
КонецФункции

