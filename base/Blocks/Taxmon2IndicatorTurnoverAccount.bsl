//DynamicDirective
Функция РассчитатьИниПоРегистру(ПараметрыВызова)
	Возврат LocalCalcIni(ПараметрыВызова);
КонецФункции	

Функция ИмяМетаданныхПоСсылкеНаОбъект(СсылкаНаОбъект)
	ТипЗначения = ТипЗнч(СсылкаНаОбъект);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Возврат ОбъектМетаданных.Имя;
КонецФункции

// Функция index_indicators_by_account_code
//
// Параметры:
//  Показатели - Массив - Массив показателей в начальном виде
//
// Возвращаемое значение:
//  Массив - Результат выполнения функции = индексированные показатели по коду
//
Функция index_indicators_by_account_code(Показатели)
	
	ИндексированныеПоказатели = Новый Соответствие;
	
	Для Каждого Показатель Из Показатели["Показатели"] Цикл
		СтруктураПоказателя = Новый Соответствие;
		СтруктураПоказателя.Вставить("КодПоказателя", Показатель["Имя"]);
		СтруктураПоказателя.Вставить("Приоритет", Показатель["Приоритет"]);
		СтруктураПоказателя.Вставить("Рейтинг", 0);
		СтруктураПоказателя.Вставить("СпособХранения", Показатель["СпособХранения"]);
		Для Каждого Парам Из Показатель["Параметры"] Цикл
			КодСчета = get_prop(Парам, "Счет");
			СтруктураПоказателя.Вставить("Параметры", Парам);
		КонецЦикла;
		Детализация = Новый Соответствие;
		Для Каждого Детал Из Показатель["ДетализацияЭкспорт"] Цикл
			ДеталИмя = Новый Соответствие;
			ДеталИмя.Вставить("СпособПолучения", Детал["СпособПолучения"]);
			ДеталИмя.Вставить("ЗначениеПоУмолчанию", Детал["ЗначениеПоУмолчанию"]);
			Детализация.Вставить(Детал["Имя"], ДеталИмя);
		КонецЦикла;
		СтруктураПоказателя.Вставить("Детализация", Детализация);
		
		СписокПоказателейПоКодуСчета = get_prop(ИндексированныеПоказатели, КодСчета);
		Если СписокПоказателейПоКодуСчета = Неопределено Тогда
			СписокПоказателейПоКодуСчета = Новый Массив;
		КонецЕсли;
		СписокПоказателейПоКодуСчета.Добавить(СтруктураПоказателя);
		
		ИндексированныеПоказатели.Вставить(КодСчета, СписокПоказателейПоКодуСчета);
	КонецЦикла;
	
	Возврат ИндексированныеПоказатели;
	
КонецФункции

// Функция index_indicators_by_name
//
// Параметры:
//  Показатели - Массив - Массив показателей в начальном виде
//
// Возвращаемое значение:
//  Массив - Результат выполнения функции = индексированные показатели по имени
//
Функция index_indicators_by_name(Показатели)
	
	ИндексированныеПоказатели = Новый Соответствие;
	
	Для Каждого Показатель Из Показатели["Показатели"] Цикл
		СтруктураПоказателя = Новый Соответствие;
		СтруктураПоказателя.Вставить("КодПоказателя", Показатель["Имя"]);
		СтруктураПоказателя.Вставить("Приоритет", Показатель["Приоритет"]);
		СтруктураПоказателя.Вставить("Рейтинг", 0);
		СтруктураПоказателя.Вставить("СпособХранения", Показатель["СпособХранения"]);
		КодСчета = "";
		СтруктураПоказателя.Вставить("КодСчета", КодСчета);
		Для Каждого Парам Из Показатель["Параметры"] Цикл
			СтруктураПоказателя.Вставить("КодСчета", get_prop(Парам, "Счет"));
			СтруктураПоказателя.Вставить("Параметры", Парам);
		КонецЦикла;
		Детализация = Новый Соответствие;
		Для Каждого Детал Из Показатель["ДетализацияИмпорт"] Цикл
			ДеталИмя = Новый Соответствие;
			ДеталИмя.Вставить("СпособПолучения", Детал["СпособПолучения"]);
			ДеталИмя.Вставить("ЗначениеПоУмолчанию", Детал["ЗначениеПоУмолчанию"]);
			Детализация.Вставить(Детал["Имя"], ДеталИмя);
		КонецЦикла;
		СтруктураПоказателя.Вставить("Детализация", Детализация);
		Если get_prop(ИндексированныеПоказатели, Показатель["Имя"]) = Неопределено Тогда
			ИндексированныеПоказатели.Вставить(Показатель["Имя"], Новый Массив);
		КонецЕсли;
		ИндексированныйПоказатель = get_prop(ИндексированныеПоказатели, Показатель["Имя"]);
		ИндексированныйПоказатель.Добавить(СтруктураПоказателя);
		
	КонецЦикла;
	
	Возврат ИндексированныеПоказатели;
	
КонецФункции

