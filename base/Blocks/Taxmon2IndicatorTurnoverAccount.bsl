// Проверяет наличие полей с суммами НУ в таблице ХозрасчетныйОборотыДтКт
//Возвращаемое значение:
//ИмяПоляСуммы - Строка - Имя поля суммы для текста запроса
Функция ПолучитьСуммуХозрасчетныйОстаткиИОбороты()
	Попытка
		// BSLLS:VirtualTableCallWithoutParameters-off
		ТестовыйЗапрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	ХозрасчетныйОстаткиИОбороты.СуммаНУКонечныйОстатокКт КАК НУКонечныйОстатокКт
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты КАК ХозрасчетныйОстаткиИОбороты");
		ТестовыйЗапрос.Выполнить();
		// BSLLS:VirtualTableCallWithoutParameters-on
		ИмяПоляСуммы = "СуммаНУ";	
	Исключение	
		ИмяПоляСуммы = "Сумма";	
	КонецПопытки;
	Возврат ИмяПоляСуммы;
КонецФункции

Функция ПолучитьОборотыПоСчету(api3_taxmon_report, ТекстЗапроса, ПараметрыЗапроса, Счет)
	Запрос = Новый Запрос;
	УстановитьПараметрыЗапросаПоНМ(Запрос, api3_taxmon_report, ПараметрыЗапроса);
	ДатаКнц = ПреобразоватьСтрокуВДату("dd.MM.yyyy HH:mm:ss", get_prop(api3_taxmon_report, "ДатаКнц") + " 23:59:59");
	Запрос.УстановитьПараметр("Граница", Новый Граница(ДатаКнц, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Счет", ПланыСчетов["Хозрасчетный"].НайтиПоРеквизиту("КодБыстрогоВыбора", Счет));
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат ТаблицаЗначенийВМассив(РезультатЗапроса);
КонецФункции

Процедура УстановитьПараметрыЗапросаПоНМ(Запрос, api3_taxmon_report, ПараметрыЗапроса)
	Запрос.УстановитьПараметр("ДатаНач", ПреобразоватьСтрокуВДату("dd.MM.yyyy", get_prop(api3_taxmon_report, "ДатаНач")));
	ДатаКнц = ПреобразоватьСтрокуВДату("dd.MM.yyyy HH:mm:ss", get_prop(api3_taxmon_report, "ДатаКнц") + " 23:59:59");
	Запрос.УстановитьПараметр("ДатаКнц", ДатаКнц);
	Запрос.УстановитьПараметр("НашаОрганизация", ПривестиAPI3ОбъектКСсылке(get_prop(api3_taxmon_report, "НашаОрганизация")));	
	Для каждого _param Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(_param.Ключ, _param.Значение);
	КонецЦикла;
КонецПроцедуры	

//Вызывает расчет ини на сервере
