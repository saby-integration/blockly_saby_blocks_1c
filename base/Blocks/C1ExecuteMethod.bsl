

Функция ОбработкаВФКВО3(context = Неопределено)
	ОбработкаВФКВО3 = get_prop(context, "ОбработкаВФКВО3");
	Если ОбработкаВФКВО3 = Неопределено Тогда 
		СправочникДополнительныеОтчетыИОбработки = ИмяСправочникаДопОтчетыИОбработки();
		ИмяОбработки = "SabyВФК";
		ОбработкаВФКВО3 = ОбработкаВО3(СправочникДополнительныеОтчетыИОбработки, ИмяОбработки); 
		Если Не ЗначениеЗаполнено(ОбработкаВФКВО3) Тогда
			ВызватьИсключение "В справочнике " + СправочникДополнительныеОтчетыИОбработки + " отсутствует обработка " + ИмяОбработки;
		КонецЕсли;	
	КонецЕсли;
	Если ТипЗнч(context) = Тип("Структура") Тогда
		context.Вставить("ОбработкаВФКВО3", ОбработкаВФКВО3);
	КонецЕсли;	
	Возврат ОбработкаВФКВО3;
КонецФункции

Процедура c1_execute_method_deletefile(ИмяВременногоФайла)
	Попытка
		// BSLLS:UsingSynchronousCalls-off Для совместимости со старыми платформами
		УдалитьФайлы(ИмяВременногоФайла);
		// BSLLS:UsingSynchronousCalls-off
	Исключение
		Возврат;
	КонецПопытки;	
КонецПроцедуры

Функция c1_execute_method_calc_value(ИмяОбработки, ИмяМетода, ПараметрыМетода, context)
	Если ИмяОбработки = "VO3" Тогда 
		ОбработкаВО3 = ОбработкаДляДлительнойОперации(context);				
	ИначеЕсли ИмяОбработки = "VFC" Тогда
		ОбработкаВО3 = ОбработкаВФКВО3(context);			
	Иначе
		ВызватьИсключение "Неизвестное имя обработки " + Строка(ИмяОбработки);
	КонецЕсли;	 
	ИмяФайла = ПолучитьИмяВременногоФайла("epf");
	ХранилищеОбработки = ОбработкаВО3.ХранилищеОбработки.Получить();
	ХранилищеОбработки.Записать(ИмяФайла);   
	ПараметрыЗащиты = ЗащитаОтОпасныхДействий();
	ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь, ПараметрыЗащиты);	
	c1_execute_method_deletefile(ИмяФайла);
	Возврат ВнешняяОбработка.ВыполнитьМетодНаСервере(ИмяМетода, ПараметрыМетода);
КонецФункции	

//DynamicDirective

Функция block_c1_execute_method_calc_value(block_type, node, path, context, block_context)
	
	required_param = Новый Массив;
	required_param.Добавить("EXECUTOR");
	required_param.Добавить("METHOD_NAME");
	block_check_required_param_in_block_context(required_param, block_context);
	begin = ДатаВМиллисекундах();
	Title = "Выполнить метод";
	Subtitle = get_subtitle_from_comment_id(node, block_context);
	Попытка 
		ИмяОбработки = get_prop(block_context, "EXECUTOR");
		ИмяМетода = get_prop(block_context, "METHOD_NAME");
		ПараметрыМетода = get_prop(block_context, "METHOD_PARAM");
		Результат = c1_execute_method_calc_value(ИмяОбработки, ИмяМетода, ПараметрыМетода, context);
	Исключение   
		ИнфОбОшибкеБл = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибкеБл);
		Если ЭтоСлужебнаяОшибкаБлока(ОшибкаСтруктура.type) Тогда
			ВызватьИсключение ИнфОбОшибкеБл.Описание; // (исходное исключение)
		КонецЕсли;
        DataActn = Новый Структура;
		DataActn.Вставить("message", get_prop(ОшибкаСтруктура, "message"));
		DataActn.Вставить("detail", get_prop(ОшибкаСтруктура, "detail"));
        end = ДатаВМиллисекундах();
		block_saby_execute_action_write_esoaction(begin, end, Title, Subtitle, DataActn, , 100);		
		ВызватьИсключение NewExtExceptionСтрока(ИнфОбОшибкеБл,,,, add_block_to_dump(block_context));;	
	КонецПопытки;
	end = ДатаВМиллисекундах();
	block_saby_execute_action_write_esoaction(begin, end, Title, Subtitle);			
	Возврат Результат;
КонецФункции
