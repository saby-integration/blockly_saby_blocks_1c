Функция ЭтоНеПростойТип(Знач ИмяТипа) Экспорт
	Если ПустаяСтрока(ИмяТипа) Тогда
        Возврат Ложь;
	КонецЕсли;
	
	ПростыеТипы = Новый Массив;
	ПростыеТипы.Добавить("Число");
	ПростыеТипы.Добавить("Строка");
	ПростыеТипы.Добавить("Дата");
	ПростыеТипы.Добавить("Булево");
	
	Если ПростыеТипы.Найти(Строка(ИмяТипа)) = Неопределено Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции	

