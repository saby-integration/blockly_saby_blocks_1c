

//DynamicDirective

Процедура ЗаполнитьФильтрыЗадач(ПараметрыОтображения) 
	МассивФильтров = Новый Массив;	
	ФильтрСоответствие = Новый Соответствие;
	ФильтрСоответствие.Вставить("NAME", "Дата");
	ФильтрСоответствие.Вставить("TITLE", "Период");
	ФильтрСоответствие.Вставить("DEFAULT_VALUE", 30);
	ФильтрСоответствие.Вставить("TEMPLATE", "filter_period");
	МассивФильтров.Добавить(ФильтрСоответствие);
	ПараметрыОтображения.Вставить("FILTER", МассивФильтров);
КонецПроцедуры

//DynamicDirective

Функция КолонкаЗадач(NAME, TITLE, TYPE, PROPERTY, VISIBLE, WIDTH, HORIZONTALSTRETCH = Истина, MORE_LOAD = Ложь) 
	КолонкаСписка = Новый Соответствие;
	КолонкаСписка.Вставить("NAME", NAME);
	КолонкаСписка.Вставить("TITLE", TITLE);
	КолонкаСписка.Вставить("TYPE", TYPE);
	КолонкаСписка.Вставить("PROPERTY", PROPERTY);
	КолонкаСписка.Вставить("VISIBLE", VISIBLE);
	КолонкаСписка.Вставить("WIDTH", WIDTH);
	КолонкаСписка.Вставить("ALIGN", "2");
	КолонкаСписка.Вставить("HORIZONTALSTRETCH", HORIZONTALSTRETCH);
	КолонкаСписка.Вставить("MORE_LOAD", MORE_LOAD);
	КолонкаСписка.Вставить("TEMPLATE", "column_default");
	Возврат КолонкаСписка;
КонецФункции

//DynamicDirective

Функция КолонкаСтатусСБИС() 
	КолонкаСтатусСБИС = Новый Соответствие;
	КолонкаСтатусСБИС.Вставить("NAME", "СтатусСБИС");
	КолонкаСтатусСБИС.Вставить("TITLE", ЛокализацияНазваниеПродукта());
	КолонкаСтатусСБИС.Вставить("PROPERTY", "СтатусСБИС");
	КолонкаСтатусСБИС.Вставить("VISIBLE", Истина);
	КолонкаСтатусСБИС.Вставить("WIDTH", "50");
	КолонкаСтатусСБИС.Вставить("TEMPLATE", "column_icon");
	КолонкаСтатусСБИС.Вставить("ALIGN", "2");
	КолонкаСтатусСБИС.Вставить("HORIZONTALSTRETCH", Ложь);
	ICON = Новый Соответствие;
	ICON.Вставить("KEY", "Интеграция");
	ICON.Вставить("VALUE", "СтатусыСБИС"); 
	ICONS = Новый Массив;	
	ICONS.Добавить(ICON);
	КолонкаСтатусСБИС.Вставить("ICONS", ICONS);
	Возврат КолонкаСтатусСБИС;
КонецФункции

