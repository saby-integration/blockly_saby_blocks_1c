//DynamicDirective

Процедура ЗаполнитьКолонкиЗадач(ПараметрыОтображения)
// BSLLS:MagicNumber-off	
	МассивКолонок = Новый Массив;
	ТипСтрока = "Строка";
	КолонкаСтатус1С = КолонкаСтатус1C();
	МассивКолонок.Добавить(КолонкаСтатус1С); 
	
	КолонкаСтатусСБИС = КолонкаСтатусСБИС();
	МассивКолонок.Добавить(КолонкаСтатусСБИС); 
	
	КолонкаДата = КолонкаЗадач("Дата", "Дата", "Дата", "Документ.Дата", Истина, 120, Ложь);
    МассивКолонок.Добавить(КолонкаДата);
	
	КолонкаНомер = КолонкаЗадач("Номер", "Номер", ТипСтрока, "Документ.Номер", Истина, 110, Ложь);
    МассивКолонок.Добавить(КолонкаНомер);

	ШиринаПоУмолчанию = 230;
	КолонкаНазвание = КолонкаЗадач("Название", "Название", ТипСтрока, "Документ.Название", Истина, ШиринаПоУмолчанию);
	МассивКолонок.Добавить(КолонкаНазвание); 
	РеквизитСотрудники = "Документ.Сотрудники.0.ФИО";
	КолонкаСотрудник = КолонкаЗадач("Сотрудник", "Сотрудник", ТипСтрока, РеквизитСотрудники, Истина, ШиринаПоУмолчанию, Истина, Истина);
	МассивКолонок.Добавить(КолонкаСотрудник); 
	РеквизитОрганизация = "Документ.НашаОрганизация.Название";
	КолонкаОрганизация = КолонкаЗадач("Организация", "Наша организация", ТипСтрока, РеквизитОрганизация, Истина, ШиринаПоУмолчанию);
	МассивКолонок.Добавить(КолонкаОрганизация); 
 	КолонкаЭтап = КолонкаЗадач("Этап", "Этап", ТипСтрока, "Документ.Этап.Название", Истина, ШиринаПоУмолчанию);
	МассивКолонок.Добавить(КолонкаЭтап); 
 	КолонкаДокументСБИС = КолонкаЗадач("ДокументСБИС", "ДокументСБИС", "Соответствие", "Документ", Ложь, ШиринаПоУмолчанию);
	МассивКолонок.Добавить(КолонкаДокументСБИС); 
	СтрокаДокументИС = "ДокументИС";
	КолонкаДокументИС = КолонкаЗадач(СтрокаДокументИС, СтрокаДокументИС, "ДокументСсылка", СтрокаДокументИС, Ложь, ШиринаПоУмолчанию);
	МассивКолонок.Добавить(КолонкаДокументИС); 
	
	ПараметрыОтображения.Вставить("COLUMNS", МассивКолонок);
// BSLLS:MagicNumber-on
КонецПроцедуры  

//DynamicDirective

Функция КомандаЗадач(NAME = "", TITLE = "", ICON = "", DESCRIPTION = "", DEFAULT_BUTTON = Ложь, SHOW_IN_MAIN_TOOLBAR = Истина, 
					 SHOW_IN_DEFAULT_TOOLBAR = Ложь, SHOW_IN_OPERATION_PANEL = Ложь, SHOW_IN_ITEM_ACTION = Истина, ACTION = "");
    Команда = Новый Соответствие;
	Команда.Вставить("NAME", NAME);
	Команда.Вставить("TITLE", TITLE);
	Команда.Вставить("ICON", ICON);
	Команда.Вставить("DESCRIPTION", DESCRIPTION);
	Команда.Вставить("DEFAULT_BUTTON", DEFAULT_BUTTON);
	Команда.Вставить("SHOW_IN_MAIN_TOOLBAR", SHOW_IN_MAIN_TOOLBAR);
	Команда.Вставить("SHOW_IN_DEFAULT_TOOLBAR", SHOW_IN_DEFAULT_TOOLBAR);
	Команда.Вставить("SHOW_IN_OPERATION_PANEL", SHOW_IN_OPERATION_PANEL);
	Команда.Вставить("SHOW_IN_ITEM_ACTION", SHOW_IN_ITEM_ACTION);
	Команда.Вставить("ACTION", ACTION);
	Команда.Вставить("TEMPLATE", "command");
	
	Возврат Команда; 
КонецФункции

//DynamicDirective

Процедура ЗаполнитьКомандыЗадач(ПараметрыОтображения)
	КомандыЗадач = Новый Массив;
	КомандаВыполнитьSABY = КомандаЗадач("ВыполнитьВSABYНажатие", "Выполнить в " + ЛокализацияНазваниеПродукта(),,,,,,,, "ВыполнитьВSABYНажатие");  
	КомандыЗадач.Добавить(КомандаВыполнитьSABY);
	
	МенюКомандВыгрузитьВ1С = КомандаЗадач("ВыгрузитьВ1СМеню", "Выгрузить в 1С");  
   	МенюКомандВыгрузитьВ1С.Вставить("TEMPLATE", "menu"); 
	КомандыВыгрузитьВ1С = Новый Массив;
	КомандаВыгрузитьОбъектВ1СНаКлиенте = КомандаЗадач("ВыгрузитьОбъектВ1СНаКлиенте", "Выгрузить в 1С",,,,,,,, "ВыгрузитьОбъектВ1СНаКлиенте");  
 	КомандаВыгрузитьВложенияНаКлиенте = КомандаЗадач("ВыгрузитьВложенияНаКлиенте", "Выгрузить вложения из " + ЛокализацияНазваниеПродукта(),,,,,,,, "ВыгрузитьВложенияНаКлиенте");  
    КомандыВыгрузитьВ1С.Добавить(КомандаВыгрузитьОбъектВ1СНаКлиенте);
    КомандыВыгрузитьВ1С.Добавить(КомандаВыгрузитьВложенияНаКлиенте);
	МенюКомандВыгрузитьВ1С.Вставить("COMMANDS", КомандыВыгрузитьВ1С); 
	КомандыЗадач.Добавить(МенюКомандВыгрузитьВ1С);
	
	КомандаОбновитьВСБИСНажатие = КомандаЗадач("ОбновитьВСБИСНажатие", "Обновить в " + ЛокализацияНазваниеПродукта(),,,,,,,, "ОбновитьВСБИСНажатие");  
	КомандыЗадач.Добавить(КомандаОбновитьВСБИСНажатие);

	КомандаОбновитьВСБИСНажатие = КомандаЗадач("ОткрытьВSABYНажатие", "Открыть в " + ЛокализацияНазваниеПродукта(),,,,,,,, "ОткрытьВSABYНажатие");  
	КомандыЗадач.Добавить(КомандаОбновитьВСБИСНажатие);
 	
	КомандаОбновить = КомандаЗадач("REFRESH_ITEMS", "Обновить",,,,,,,, "REFRESH_ITEMS");  
	КомандыЗадач.Добавить(КомандаОбновить);
   
    ПараметрыОтображения.Вставить("ACTIONS", КомандыЗадач);
КонецПроцедуры

//DynamicDirective

Процедура ЗаполнитьПараметрыОтображенияЗадач(ПараметрыОтображения)
	ЗаполнитьФильтрыЗадач(ПараметрыОтображения);
	ЗаполнитьКолонкиЗадач(ПараметрыОтображения);
	ЗаполнитьКомандыЗадач(ПараметрыОтображения);
КонецПроцедуры

//DynamicDirective

Функция block_view_list_tasks_calc_value(block_type, node, path, context, block_context)
	param = Новый Соответствие;
	copy_block_context(param, block_context);
	param.Вставить("TEMPLATE", "list_flat");
	ЗаполнитьПараметрыОтображенияЗадач(param);
	param.Вставить("FORM", "ПросмотрДокумента");
	Возврат param;
КонецФункции	

