//  Структура - Результат выполения функции
//
//DynamicDirective
Функция block_c1_call_select_get_value(node)	               
	Возврат node.ПервыйДочерний.ТекстовоеСодержимое;
КонецФункции

// Функция block_c1_call_select_get_param
//
// Параметры:
// node - XML - Текущий обрабатываемый узел XML
// path - Строка - Абсолютный путь до исполняемого блока
// context - Соответствие - Контекст исполняемого блока
// block_context - Соответствие - Контекст текущего выполняемого блока
//
// Возвращаемое значение:
//  Структура - Результат выполения функции
//
//DynamicDirective
Функция block_c1_call_select_get_param(node, path, context, block_context)
	param = Новый Структура;
	РезультатXpath_PARAM = Workspace.ВычислитьВыражениеXpath("./b:value[contains(@name,'PARAM')]", node, размыватель);
	РезультатXpath_FIELD = Workspace.ВычислитьВыражениеXpath("./b:field[contains(@name,'FIELD')]", node, размыватель);
	Пока Истина Цикл
		Узел_PARAM = РезультатXpath_PARAM.ПолучитьСледующий();
		Если Узел_PARAM = Неопределено Тогда Прервать КонецЕсли;
		Узел_FIELD = РезультатXpath_FIELD.ПолучитьСледующий();
		Если Узел_FIELD = Неопределено Тогда Прервать КонецЕсли;
		res = block_execute_all_next(Узел_PARAM, path + "." + "main", context, block_context);
		param_name = Узел_FIELD.ТекстовоеСодержимое;
		param.Вставить(param_name, res);
	КонецЦикла;
	
	Возврат param; 
КонецФункции

//DynamicDirective

Процедура ВыделитьИдентификаторАккаунт(СтрокаЗапроса)
	ИдСБИС = get_prop(СтрокаЗапроса, "ИдСБИС");	
	Если Не ЗначениеЗаполнено(ИдСБИС) Тогда 
		Возврат;
	КонецЕсли;	
	ИдСБИСИтог = "";
	Аккаунт = "";
	МассивСтрокСРазделителем = СтрРазделить82(ИдСБИС, "_");	
	Для Каждого ВыбраннаяСтрока Из МассивСтрокСРазделителем Цикл  
		Если СтрДлина(ВыбраннаяСтрока) <> 36 Тогда 
			Если СтрДлина(ВыбраннаяСтрока) > 0 Тогда
				Аккаунт = ВыбраннаяСтрока;
			КонецЕсли;	
			Продолжить;
		КонецЕсли;	 
		Если ИдСБИСИтог <> "" Тогда
			ИдСБИСИтог = ИдСБИСИтог + "_";
		КонецЕсли;
		ИдСБИСИтог = ИдСБИСИтог + ВыбраннаяСтрока;	
	КонецЦикла;
	СтрокаЗапроса.Вставить("ИдСБИС", ИдСБИСИтог);
	СтрокаЗапроса.Вставить("Аккаунт", Аккаунт);
КонецПроцедуры

//DynamicDirective

Процедура ОбсчитатьЗаписьВыборки(ДочернийУзел, path, context, block_context)
    block_execute_all_next(ДочернийУзел, path, context, block_context, True);
	Строка = block_get_variable(context, block_context["VAR"]);
	ВыделитьИдентификаторАккаунт(Строка);	
	block_context["ROWS"].Добавить(Строка);	
КонецПроцедуры

