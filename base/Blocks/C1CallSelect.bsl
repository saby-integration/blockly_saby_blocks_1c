Функция ДополнитьЗапросСтатусамиСаби(ТекстЗапроса)   
	Если ИнтеграцияСтатусыДокументов = Неопределено Тогда
		СтатусыДокументовИнициализация();
	КонецЕсли;
	Стенд = ИнтеграцияСтатусыДокументов.Сервис;
	Если Найти(ТекстЗапроса, "&ПоляСабиСтатусов КАК ПоляСабиСтатусов") > 0 И Найти(ТекстЗапроса, "КАК ТаблицаОбъектовИС") > 0 Тогда
		// Замена блока полей
		ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ПоляСабиСтатусов КАК ПоляСабиСтатусов",
		"ЕСТЬNULL(ХранилищеСтатусовSabyСтатус.Значение, -1) КАК СтатусСБИС," + Символы.ПС +
		"	ЕСТЬNULL(ХранилищеСтатусовSabyИд.Значение, """") КАК ИдСБИС," + Символы.ПС +
		"	ЕСТЬNULL(ХранилищеСтатусовSabyТекущийЭтап.Значение, """") КАК АктивныйЭтап"
		);
		
		// Вставка ЛЕВОЕ СОЕДИНЕНИЕ после "КАК ТаблицаОбъектовИС"
		ХранилищеСтатусовSaby = СтатусыДокументовИмяРегистраСвойствОбъектов();
		
		ДопСоединения = Символы.ПС + 
		"	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений." + ХранилищеСтатусовSaby + " КАК ХранилищеСтатусовSabyСтатус" + Символы.ПС +
		"	ПО ТаблицаОбъектовИС.Ссылка = ХранилищеСтатусовSabyСтатус.Объект" + Символы.ПС +
		"		И (ХранилищеСтатусовSabyСтатус.Свойство.Наименование = """ + Стенд + "ДокументСБИС_Статус"")" + Символы.ПС +
		"	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений." + ХранилищеСтатусовSaby + " КАК ХранилищеСтатусовSabyИд" + Символы.ПС +
		"	ПО ТаблицаОбъектовИС.Ссылка = ХранилищеСтатусовSabyИд.Объект" + Символы.ПС +
		"		И (ХранилищеСтатусовSabyИд.Свойство.Наименование = """ + Стенд + "ДокументСБИС_Ид"")" + Символы.ПС +
		"	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений." + ХранилищеСтатусовSaby + " КАК ХранилищеСтатусовSabyТекущийЭтап" + Символы.ПС +
		"	ПО ТаблицаОбъектовИС.Ссылка = ХранилищеСтатусовSabyТекущийЭтап.Объект " +
		"		И (ХранилищеСтатусовSabyТекущийЭтап.Свойство.Наименование = """ + Стенд + "ДокументСБИС_ТекущийЭтап"")";
		
		ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"КАК ТаблицаОбъектовИС",
		"КАК ТаблицаОбъектовИС" + ДопСоединения
		);
	КонецЕсли;
	
	// Замена условий 
	Если Найти(ТекстЗапроса, "&УсловияСабиСтатусов") > 0 Тогда
		ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&УсловияСабиСтатусов",
		"(&СтатусСБИСНеЗаполнено ИЛИ ЕСТЬNULL(ХранилищеСтатусовSabyСтатус.Значение, ""-1"") = &СтатусСБИС)"
		);
	КонецЕсли;	
	
	Возврат ТекстЗапроса; 
	
КонецФункции

