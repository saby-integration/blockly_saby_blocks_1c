
Функция ЗаписьВыборкиВСтруктуру(ЗаписьВыборки, КолонкиВыборки)
	ТекущаяЗапись = Новый Структура;
	Для Каждого Колонка Из КолонкиВыборки Цикл
		ТекущаяЗапись.Вставить(Колонка.Имя, ЗаписьВыборки[Колонка.Имя]);	
	КонецЦикла;
	Возврат ТекущаяЗапись;
КонецФункции

Функция ПривестиAPI3ОбъектКСсылке(ЗначениеПараметра) 
	Результат = ЗначениеПараметра;
	Если ТипЗнч(ЗначениеПараметра) <> Тип("Структура") 
		И ТипЗнч(ЗначениеПараметра) <> Тип("Соответствие")
		И ТипЗнч(ЗначениеПараметра) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(ЗначениеПараметра) = Тип("Массив") Тогда 
		Результат = Новый Массив;
		Для Каждого Элемент_ЗначениеПараметра Из ЗначениеПараметра Цикл
			Результат.Добавить(ПривестиAPI3ОбъектКСсылке(Элемент_ЗначениеПараметра));
		КонецЦикла;
	Иначе
		ИмяИС = get_prop(ЗначениеПараметра, "ИмяИС", Неопределено);
		ИдИС = get_prop(ЗначениеПараметра, "ИдИС", Неопределено);
		ТипИС = get_prop(ЗначениеПараметра, "ТипИС", Неопределено); 
		Если ЗначениеЗаполнено(ТипИС) Тогда
			ИмяИС = ТипИС + "." + ИмяИС;	
		КонецЕсли;
		Если ИдИС <> Неопределено И ИмяИС <> Неопределено Тогда 
			Попытка 
				Результат = ПолучитьСсылкуПоИдИС(ИмяИС, ИдИС);
			Исключение
				Возврат Результат;	
			КонецПопытки;	
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;	
КонецФункции

Функция ВыполнитьЗапросНаСервере(ТекстЗапроса, param)  
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Для каждого _param Из param Цикл
		ЗначениеПараметра = ПривестиAPI3ОбъектКСсылке(_param.Значение);
		Запрос.УстановитьПараметр(_param.Ключ, ЗначениеПараметра);
	КонецЦикла;
	Возврат ТаблицаЗначенийВМассив(Запрос.Выполнить().Выгрузить());	
КонецФункции

// Функция block_c1_call_select_execute
//
// Параметры:
// block_type - Строка - Название блока
// node - XML - Текущий обрабатываемый узел XML
// path - Строка - Абсолютный путь до исполняемого блока
// context - Соответствие - Контекст исполняемого блока
// block_context - Соответствие - Контекст текущего выполняемого блока
//
// Возвращаемое значение:
//  Структура - Результат выполения функции
//
//DynamicDirective
Функция block_c1_call_select_execute(block_type, node, path, context, block_context)
	Если block_context.Свойство("result") Тогда
		Возврат block_context["result"];
	КонецЕсли;

	begin = ДатаВМиллисекундах();
	Title = "Выполнение запроса в ИС";
	Subtitle = get_prop(block_context, "__id");
	Попытка
		_select_node = workspace_find_input_by_name(node, "select");
		res = block_execute_all_next(_select_node, path + "." + "main", context, block_context);
		ТекстЗапроса = res;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", Символы.ВК + "ВЫБРАТЬ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ";", ";" + Символы.ВК);
		param = block_c1_call_select_get_param(node, path, context, block_context);
		block_check_step(context, block_context);
		
		Если ЗначениеЗаполнено(ТекстЗапроса) Тогда		
			Результат = ВыполнитьЗапросНаСервере(ТекстЗапроса, param) ; 
			block_context.Вставить("result", Результат);
		Иначе
			block_context.Вставить("result", Неопределено);
		КонецЕсли;
	Исключение
		ИнфОбОшибкеБлок = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибкеБлок);
		Если ЭтоСлужебнаяОшибкаБлока(ОшибкаСтруктура.type) Тогда
			ВызватьИсключение ИнфОбОшибкеБлок.Описание; // (исходное исключение)
		КонецЕсли;
        DataSel = Новый Структура;
		DataSel.Вставить("message", get_prop(ОшибкаСтруктура, "message"));
		DataSel.Вставить("detail", get_prop(ОшибкаСтруктура, "detail"));
        end = ДатаВМиллисекундах();
		block_saby_execute_action_write_esoaction(begin, end, Title, Subtitle, DataSel, , 100);		
		ВызватьИсключение ИнфОбОшибкеБлок.Описание;	
	КонецПопытки;
	end = ДатаВМиллисекундах();
	block_saby_execute_action_write_esoaction(begin, end, Title, Subtitle);			
	Возврат block_context["result"];

КонецФункции

