
// Группировка через реквизит структуры
//
// Параметры:
//  block_type - Строка - Название блока
// 	node - Структура - Dom структура хмл
//  path - Строка - Пусть до блока по алгоритму
//  context - Структура - Общий контекст алгоритма
//  block_context - Структура - Контекст исполняемого блока
//
// Возвращаемое значение:
//  - Структура - Результат обсчета алгоритма
//
//DynamicDirective
Функция block_list_obj_group_calc_value(block_type, node, path, context, block_context)
	required_param = Новый Массив;
	required_param.Добавить("LIST");
	required_param.Добавить("PARAMS");
	block_check_required_param_in_block_context(required_param, block_context);	
	ГруппируемыйСписок = block_context["LIST"];
	ПолеГруппировки = block_context["PARAMS"];
	РезультатСписокИтого = Новый Массив();
	МассивПоиска = Неопределено;
	Если ТипЗнч(ПолеГруппировки) = Тип("Строка") Тогда 
		МассивПоиска = Новый Массив;
		МассивПоиска.Добавить(ПолеГруппировки);
	ИначеЕсли ТипЗнч(ПолеГруппировки) = Тип("Массив") Тогда
		МассивПоиска = ПолеГруппировки; 
	Иначе
		ВызватьИсключение NewExtExceptionСтрока(, "Неправильный тип группировки в блоке list_obj_group",
			"Ожидалась строка или список");
	КонецЕсли;
    РезультатСтруктура = ГруппируемыйСписокМассив(ГруппируемыйСписок, МассивПоиска);	
	Для Каждого Элемент Из РезультатСтруктура Цикл
		РезультатСписок = Новый Массив();
		Для Каждого ЭлементСтруктуры Из Элемент.Значение Цикл
			РезультатСписок.Добавить(ЭлементСтруктуры);
		КонецЦикла;
		РезультатСписокИтого.Добавить(РезультатСписок);
	КонецЦикла;
	Возврат РезультатСписокИтого;
КонецФункции

// Группировка если это массив
//
// Параметры:
// 	ГруппируемыйСписок - Структура - Группируемая структура
//  ПолеГруппировки - Строка - Поле для группировки
//
// Возвращаемое значение:
//  - Структура - Результат обсчета алгоритма
//
// Необходимости менять функцию нет
// BSLLS:NestedStatements-off
// BSLLS:CognitiveComplexity-off
//DynamicDirective
Функция ГруппируемыйСписокМассив(ГруппируемыйСписок, ПолеГруппировки)
    ВсеВариантыЗначенийРеквизитов = Новый Массив();
    // Нахождения всех уникальных вариантов значений реквизитов
    Для Каждого ЭлементИсходногоСписка Из ГруппируемыйСписок Цикл
        Если ТипЗнч(ЭлементИсходногоСписка) <> Тип("Структура") И ТипЗнч(ЭлементИсходногоСписка) <> Тип("Соответствие") Тогда
			ВызватьИсключение NewExtExceptionСтрока(, "Неправильный тип в LIST", "Ожидался список с структурами");
		КонецЕсли;
		ЗначенияРеквизитовТекущегоЭлемента = Новый Соответствие();    
        Для Каждого РеквизитГруппировки Из ПолеГруппировки Цикл
            ЗначениеЭлементаИсходногоСписка = ЭлементИсходногоСписка[РеквизитГруппировки];
            ЗначенияРеквизитовТекущегоЭлемента.Вставить(РеквизитГруппировки, ЗначениеЭлементаИсходногоСписка);
        КонецЦикла;     
        // Проверка на наличие такого варианта значений
        ВариантНайден = Ложь;
        Для Каждого ВариантЗначений Из ВсеВариантыЗначенийРеквизитов Цикл
            Совпадает = Истина;
            Для Каждого РеквизитГруппировки Из ПолеГруппировки Цикл
                Если ВариантЗначений.Получить(РеквизитГруппировки) <> ЗначенияРеквизитовТекущегоЭлемента.Получить(РеквизитГруппировки) Тогда
                    Совпадает = Ложь;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            Если Совпадает Тогда
                ВариантНайден = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;   
        Если НЕ ВариантНайден Тогда
            ВсеВариантыЗначенийРеквизитов.Добавить(ЗначенияРеквизитовТекущегоЭлемента);
        КонецЕсли;
    КонецЦикла;
    // Группировка элементов по найденным вариантам
    РезультатСтруктура = Новый Соответствие();
    Для Каждого ЭлементИсходногоСписка Из ГруппируемыйСписок Цикл
        Для Каждого ВариантЗначений Из ВсеВариантыЗначенийРеквизитов Цикл
            Совпадает = Истина;
            Для Каждого РеквизитГруппировки Из ПолеГруппировки Цикл
                Если ЭлементИсходногоСписка[РеквизитГруппировки] <> ВариантЗначений.Получить(РеквизитГруппировки) Тогда
                    Совпадает = Ложь;
                    Прервать;
                КонецЕсли;
            КонецЦикла;    
            Если Совпадает Тогда
                Если РезультатСтруктура.Получить(ВариантЗначений) = Неопределено Тогда
                    Выборка = Новый Массив();
                    Выборка.Добавить(ЭлементИсходногоСписка);
                    РезультатСтруктура.Вставить(ВариантЗначений, Выборка); 
                Иначе
                    РезультатСтруктура[ВариантЗначений].Добавить(ЭлементИсходногоСписка);
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат РезультатСтруктура;
КонецФункции
// BSLLS:CognitiveComplexity-on
// BSLLS:NestedStatements-on
